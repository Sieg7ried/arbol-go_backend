# Puerto HTTP donde NestJS acepta solicitudes; por defecto, la aplicación usa 3000.
PORT=3000

# Entorno de ejecución: development habilita synchronize de TypeORM; producción debe usar production.
NODE_ENV=development

# Orígenes web permitidos separados por comas. En producción deben ser dominios explícitos, nunca *.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host del servidor MySQL accesible desde esta aplicación.
DB_HOST=127.0.0.1

# Puerto TCP de MySQL; el puerto estándar es 3306.
DB_PORT=3306

# Usuario MySQL dedicado a ÁRBOL GO, con los permisos mínimos necesarios.
DB_USERNAME=arbol_go_app

# Contraseña ficticia para desarrollo local; reemplázala por un secreto real fuera de este ejemplo.
DB_PASSWORD=change-this-local-password

# Nombre de la base MySQL que contiene las tablas de ÁRBOL GO.
DB_DATABASE=arbol_go

# Secreto ficticio de firma JWT. Genera uno aleatorio para cada entorno; no reutilices este valor.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Duración del JWT en segundos; 3600 equivale a una hora.
JWT_EXPIRATION=3600

# Nombre ficticio de la cuenta Cloudinary; reemplázalo por el cloud name de tu cuenta.
CLOUDINARY_NAME=your-cloudinary-cloud-name

# Clave API ficticia de Cloudinary; guárdala como secreto en los entornos desplegados.
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key

# Secreto API ficticio de Cloudinary; no lo publiques ni lo agregues al repositorio.
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Ruta a un archivo de cuenta de servicio Firebase fuera del repositorio.
# En Windows puede ser C:/secure/firebase-service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=/secure/firebase-service-account.json

# ID ficticio del proyecto Firebase que habilita Firebase Cloud Messaging.
FIREBASE_PROJECT_ID=your-firebase-project-id
